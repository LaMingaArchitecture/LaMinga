{
  "name": "laminga-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "dev": "astro dev",
    "dev:preview": "cross-env STORYBLOK_VERSION=draft astro dev --port 4322",
    "prebuild": "node scripts/generate-headers.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "audit": "pnpm audit",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check && tsc -p netlify/tsconfig.json",
    "typecheck:edge": "tsc -p netlify/tsconfig.json",
    "prepare": "husky",
    "test": "vitest run",
    "guide": "scripts/build-guide.sh"
  },
  "dependencies": {
    "@astrojs/netlify": "8.2.10",
    "@astrojs/sitemap": "3.7.4",
    "@storyblok/astro": "10.4.0",
    "astro": "7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@netlify/edge-functions": "4.0.3",
    "cross-env": "10.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "pnpm": {
    "overrides": {
      "tar@^7": "^7.5.22"
    }
  }
}
