---
/**
 * FullscreenCarousel — generic, blok-type-agnostic fullscreen scroller.
 * Wraps already-rendered slides via <slot/> (home_slide on the home, media_slide on project
 * pages), so it owns the scroll-snap track + slide sizing and neither slide type needs to know
 * it's in a carousel.
 * Progressive enhancement: the CSS scroll-snap track works with no JS (native swipe/scroll);
 * `fullscreen-carousel.ts` layers a split prev/next mouse cursor, keyboard nav, wrap-around stepping,
 * ARIA live announcements, lazy video. Per client feedback there are no visible arrows: the buttons
 * stay in the DOM for keyboard and screen-reader users and only appear on keyboard focus, and touch
 * users step by swiping (tokens.css lists this with the client decisions). They ship `disabled` and
 * the script enables them (with no JS, native swipe still works).
 */
import type { HTMLAttributes } from 'astro/types';
import Fleche from './icons/Fleche.astro';

interface Props extends HTMLAttributes<'section'> {
  /** Accessible name for the carousel region (home: "Projets à la une"; project page: the title). */
  ariaLabel: string;
}

const { ariaLabel, class: className, ...attrs } = Astro.props;
---

<section
  class:list={['fc', className]}
  aria-roledescription="carrousel"
  aria-label={ariaLabel}
  data-fc
  {...attrs}
>
  <div class="fc__track" data-fc-track>
    <slot />
  </div>

  {
    /* Absolutely-positioned overlays (project card, pills, info/related bands) live here, inside the
      positioned .fc but outside the track, so they never become slides (`track.children`). */
  }
  <slot name="overlays" />

  <button
    type="button"
    class="fc__arrow fc__arrow--prev visually-hidden-focusable"
    data-fc-prev
    aria-label="Diapositive précédente"
    disabled
  >
    <Fleche direction="left" size={28} />
  </button>
  <button
    type="button"
    class="fc__arrow fc__arrow--next visually-hidden-focusable"
    data-fc-next
    aria-label="Diapositive suivante"
    disabled
  >
    <Fleche direction="right" size={28} />
  </button>

  {
    /* Slide position ("Diapositive X sur N") is announced here only — there is no visual counter. */
  }
  <p class="visually-hidden" data-fc-live aria-live="polite" role="status"></p>
</section>

<script>
  import '../scripts/fullscreen-carousel';
</script>

<style>
  .fc {
    position: relative;
    height: 100%;
    overflow: hidden;
    /* Ink for controls/HUD text sitting directly over the photo. Flipped per active slide's
       titre_clair by the script (`[data-clair]`); overlays with their own background ignore it. */
    --hud-ink: var(--color-coral);
  }
  .fc[data-clair] {
    --hud-ink: var(--color-paper);
  }

  .fc__track {
    display: flex;
    height: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .fc__track::-webkit-scrollbar {
    display: none;
  }

  /* Generic slide sizing — turns ANY slot child into a full-viewport snap slide. */
  .fc__track > :global(*) {
    flex: 0 0 100%;
    height: 100%;
    margin: 0;
    scroll-snap-align: start;
  }
  .fc__track > :global(*) :global(img),
  .fc__track > :global(*) :global(video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Mid-height at the edges, on the logotype's gutter; shown only while keyboard-focused
     (.visually-hidden-focusable). A mouse user steps with the cursor halves, a touch user swipes. */
  .fc__arrow {
    display: grid;
    position: absolute;
    top: 50%;
    z-index: 2;
    transform: translateY(-50%);
    place-items: center;
    min-width: var(--touch-min);
    min-height: var(--touch-min);
    padding: var(--space-2);
    border: 0;
    background: none;
    color: var(--hud-ink);
    cursor: var(--cursor-link);
    filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.35));
    touch-action: manipulation;
  }
  .fc__arrow--prev {
    left: var(--page-x);
  }
  .fc__arrow--next {
    right: var(--page-x);
  }

  /* Mouse only: the photo itself is the control — each half shows the matching arrow as the cursor
     and a click there steps (fullscreen-carousel.ts sets data-fc-side; stepping wraps at both ends, so
     only a single-slide carousel goes without).
     CSS cursor images can't read currentColor, hence one inlined image per ink (tokens.css). */
  @media (hover: hover) and (pointer: fine) {
    .fc[data-fc-side='prev'] .fc__track {
      cursor: var(--cursor-prev);
    }
    .fc[data-fc-side='next'] .fc__track {
      cursor: var(--cursor-next);
    }
    .fc[data-clair][data-fc-side='prev'] .fc__track {
      cursor: var(--cursor-prev-clair);
    }
    .fc[data-clair][data-fc-side='next'] .fc__track {
      cursor: var(--cursor-next-clair);
    }
    .fc__track :global(a),
    .fc__track :global(button) {
      cursor: var(--cursor-link);
    }
  }
</style>
