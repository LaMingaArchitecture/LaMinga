---
/**
 * FullscreenCarousel — generic, blok-type-agnostic fullscreen scroller.
 * Wraps already-rendered slides via <slot/> (home_slide on the home, media_slide on project pages), so it owns the
 * scroll-snap track + slide sizing and neither slide type needs to know it's in a carousel.
 * Progressive enhancement: the CSS scroll-snap track works with no JS (native swipe/scroll);
 * `fullscreen-carousel.ts` layers arrows, a split prev/next mouse cursor, keyboard nav, ARIA live
 * announcements, lazy video. The controls render at all times — the arrows ship `disabled`
 * (dimmed) and the script enables them once ready — so they show a loading state instead of
 * popping in after load (with no JS they stay disabled while native swipe still works).
 */
import type { HTMLAttributes } from 'astro/types';
import Fleche from './icons/Fleche.astro';

interface Props extends HTMLAttributes<'section'> {
  /** Accessible name for the carousel region (home: "Projets à la une"; project page: the title). */
  ariaLabel: string;
  /**
   * Control layout: 'split' (home) = arrows mid-height at the edges;
   * 'grouped' (project page) = both arrows side by side in one bottom-right cluster.
   */
  controls?: 'split' | 'grouped';
}

const { ariaLabel, controls = 'split', class: className, ...attrs } = Astro.props;
---

<section
  class:list={['fc', { 'fc--grouped': controls === 'grouped' }, className]}
  aria-roledescription="carrousel"
  aria-label={ariaLabel}
  data-fc
  {...attrs}
>
  <div class="fc__track" data-fc-track>
    <slot />
  </div>

  {
    /* Absolutely-positioned overlays (project card, pills, info/related bands) live here, inside the
      positioned .fc but outside the track, so they never become slides (`track.children`). */
  }
  <slot name="overlays" />

  {
    /* Wrapper is `display:contents` in split mode (children keep their own absolute anchoring) and a
      flex row bottom-right in grouped mode. */
  }
  {
    /* Rendered visible at all times (never popped in). Both arrows start `disabled` (dimmed) so the
      carousel shows a loading state; the script enables/updates them per slide position once ready.
      With no JS they simply stay disabled while the native scroll-snap swipe still works. */
  }
  <div class="fc__controls">
    <button
      type="button"
      class="fc__arrow fc__arrow--prev"
      data-fc-prev
      aria-label="Diapositive précédente"
      disabled
    >
      <Fleche direction="left" size={28} />
    </button>
    <button
      type="button"
      class="fc__arrow fc__arrow--next"
      data-fc-next
      aria-label="Diapositive suivante"
      disabled
    >
      <Fleche direction="right" size={28} />
    </button>
  </div>

  {
    /* Slide position ("Diapositive X sur N") is announced here only — there is no visual counter. */
  }
  <p class="visually-hidden" data-fc-live aria-live="polite" role="status"></p>
</section>

<script>
  import '../scripts/fullscreen-carousel';
</script>

<style>
  .fc {
    position: relative;
    height: 100%;
    overflow: hidden;
    /* Ink for controls/HUD text sitting directly over the photo. Flipped per active slide's
       titre_clair by the script (`[data-clair]`); overlays with their own background ignore it. */
    --hud-ink: var(--color-coral);
  }
  .fc[data-clair] {
    --hud-ink: var(--color-paper);
  }

  .fc__track {
    display: flex;
    height: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .fc__track::-webkit-scrollbar {
    display: none;
  }

  /* Generic slide sizing — turns ANY slot child into a full-viewport snap slide. */
  .fc__track > :global(*) {
    flex: 0 0 100%;
    height: 100%;
    margin: 0;
    scroll-snap-align: start;
  }
  .fc__track > :global(*) :global(img),
  .fc__track > :global(*) :global(video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Split mode (home): the wrapper is transparent, so its children keep the absolute anchoring
     below (mid-height arrows at the edges). */
  .fc__controls {
    display: contents;
  }

  /* Controls are absolute overlays shown at ALL times (the arrows ship `disabled`/dimmed and the
     script enables them once ready), so they never pop in after load. Absolute → zero CLS. */
  .fc__arrow {
    display: grid;
    position: absolute;
    top: 50%;
    z-index: 2;
    transform: translateY(-50%);
    place-items: center;
    min-width: 44px;
    min-height: 44px;
    padding: var(--space-2);
    border: 0;
    background: none;
    color: var(--hud-ink);
    cursor: pointer;
    filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.35));
    touch-action: manipulation;
  }
  .fc__arrow--prev {
    left: var(--space-2);
  }
  .fc__arrow--next {
    right: var(--space-2);
  }
  .fc__arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }

  /* Grouped mode (project page): prev + next as one bottom-right cluster. The wrapper becomes the
     positioned box; its children flow inline. */
  .fc--grouped .fc__controls {
    position: absolute;
    right: var(--space-4);
    bottom: var(--space-4);
    z-index: 3;
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }
  .fc--grouped .fc__arrow {
    position: static;
    inset: auto;
    transform: none;
  }
  .fc--grouped .fc__arrow :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }

  /* Mouse only: the photo itself is the control — each half shows the matching arrow as the cursor
     and a click there steps (fullscreen-carousel.ts sets data-fc-side, and omits it at either end).
     CSS cursor images can't read currentColor, hence one file per ink. */
  @media (hover: hover) and (pointer: fine) {
    .fc[data-fc-side='prev'] .fc__track {
      cursor:
        url('/cursors/fleche-gauche-corail.svg') 4 16,
        pointer;
    }
    .fc[data-fc-side='next'] .fc__track {
      cursor:
        url('/cursors/fleche-droite-corail.svg') 28 16,
        pointer;
    }
    .fc[data-clair][data-fc-side='prev'] .fc__track {
      cursor:
        url('/cursors/fleche-gauche-papier.svg') 4 16,
        pointer;
    }
    .fc[data-clair][data-fc-side='next'] .fc__track {
      cursor:
        url('/cursors/fleche-droite-papier.svg') 28 16,
        pointer;
    }
    .fc__track :global(a),
    .fc__track :global(button) {
      cursor: pointer;
    }
  }
</style>
