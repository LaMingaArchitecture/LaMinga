---
import SocialLinks from './SocialLinks.astro';
import MobilePanel from './MobilePanel.astro';
import type { GlobalSettings } from '../types/storyblok';
import { LOGO_SRC } from '../lib/brand';

interface Props {
  settings: GlobalSettings | null;
}

// The page accent still themes the nav labels and social marks, but it arrives through
// `body[data-accent]` (BaseLayout) as a CSS variable — the logotype no longer varies with it.
const { settings } = Astro.props;
const social = settings?.reseaux_sociaux ?? [];
const nomAtelier = settings?.nom_atelier ?? 'LaMinga';

// Active section from the current path — a project detail belongs to the Projets section.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const activeSection: 'projets' | 'atelier' | null =
  path === '/projets' || path.startsWith('/projets/')
    ? 'projets'
    : path === '/atelier'
      ? 'atelier'
      : null;
---

<header class="site-header">
  <nav class="nav" aria-label="Navigation principale">
    {
      /* Brand column (grid column 1 on the V3 boards): logotype, then the two cartouches stacked
        directly beneath it — Projets first, matching the boards' reading order. */
    }
    <div class="nav__brand">
      <a href="/" class="nav__logo" aria-label={`${nomAtelier} — accueil`}>
        <img class="nav__logo-img" src={LOGO_SRC} alt={nomAtelier} />
      </a>
      <ul class="nav__buttons">
        <li>
          <a
            class="nav__btn brand-box"
            href="/projets"
            aria-current={activeSection === 'projets' ? 'page' : undefined}
          >
            Projets
          </a>
        </li>
        <li>
          <a
            class="nav__btn brand-box"
            href="/atelier"
            aria-current={activeSection === 'atelier' ? 'page' : undefined}
          >
            Atelier
          </a>
        </li>
      </ul>
    </div>

    <div class="nav__right">
      <SocialLinks links={social} class="nav__social" />
      <MobilePanel settings={settings} activeSection={activeSection} />
    </div>
  </nav>
</header>

<style>
  /* Two zones on one row: the brand column hugs the left page margin, the social/burger cluster the
     right. `align-items: start` keeps both pinned to the top edge while the brand column grows
     downward with its cartouches — the V3 boards put the logotype and the menu in one left stack. */
  .nav {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: start;
    gap: var(--space-4);
    padding: var(--space-2) var(--page-x);
  }

  .nav__brand {
    grid-column: 1;
    justify-self: start;
    display: flex;
    flex-direction: column;
    /* Cartouches hang directly off the logotype's bottom rule, as drawn. */
    gap: 0;
    min-width: 0;
  }

  /* The official SVG already carries the boxed outline, so the wrapper stays borderless. */
  .nav__logo {
    display: block;
    text-decoration: none;
    line-height: 1;
  }
  .nav__logo-img {
    display: block;
    height: 2.25rem;
    width: auto;
  }

  .nav__right {
    grid-column: 2;
    justify-self: end;
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  /* Header social row: desktop only (the burger panel carries social on mobile). */
  .nav__right :global(.nav__social) {
    display: none;
  }

  /* Stacked outlined nav cartouches — hidden on mobile (the burger takes over). */
  .nav__buttons {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-direction: column;
    gap: 0;
  }
  /* Box outline comes from the .brand-box utility (open-corner edges). Set background-color (not the
     background shorthand) so hover/active fills don't wipe the edge gradients. */
  .nav__btn {
    display: block;
    padding: var(--space-1) var(--space-3);
    color: var(--accent);
    font-size: 0.9375rem;
    text-decoration: none;
    text-align: left;
    /* The fill swaps via --brand-box-fill (a gradient layer), which can't transition; only the text
       colour animates. */
    transition: color var(--transition);
  }
  .nav__btn:hover {
    --brand-box-fill: color-mix(in srgb, var(--color-beige) 45%, var(--color-paper));
  }
  .nav__btn[aria-current='page'] {
    --brand-box-fill: var(--color-beige);
    color: var(--color-ink);
    font-weight: 600;
  }

  /* Tablet and up: the brand column takes over from the burger. It is not pinned to the grid column
     yet — between 48 and 64rem the filter chips still wrap freely, so a rigid column would squeeze
     them; the logotype sizes itself and the cartouches match its width. */
  @media (min-width: 48rem) {
    .nav {
      padding-block: var(--space-3);
    }
    .nav__buttons {
      display: flex;
    }
    .nav__btn {
      padding: var(--space-2) var(--space-4);
      font-size: 1.0625rem;
    }
    .nav__right :global(.nav__social) {
      display: flex;
    }
    /* The logotype fills the brand column from tablet up, so the column width alone drives its
       height — that is what --nav-clear reads to place the content below it. */
    .nav__brand {
      width: var(--nav-brand-w);
    }
    .nav__logo-img {
      height: auto;
      width: 100%;
    }
  }

  /* Desktop: the brand column locks to column 1 of the shared 6-column grid (tokens.css), so the
     cartouches line up with the Projets filter chips in columns 2-6. The logotype fills the column
     rather than carrying a fixed height, which is how the boards size it. */
  @media (min-width: 64rem) {
    .nav__btn {
      font-size: 1.125rem;
    }
  }
</style>
