---
/**
 * ProjectHudCard — the persistent bleu-clair project cartouche pinned to the bottom HUD.
 * Per the V3 board: a title cell (the page's sole <h1>) beside a stack of "Ville" / "Programme"
 * rows and, as the last row, the disclosure buttons passed in through the `actions` slot.
 * Positioning is owned by the .project-hud bar in Project.astro; this owns only the appearance.
 * "Programme" = description_programme (the one-line description), not the programme relation.
 */
interface Props {
  titre: string;
  ville?: string;
  programme?: string;
}

const { titre, ville, programme } = Astro.props;
const hasActions = Astro.slots.has('actions');
---

<div class="hud-card brand-box">
  <h1 class="hud-card__title">{titre}</h1>
  <div class="hud-card__col">
    {
      (ville || programme) && (
        <dl class="hud-card__data">
          {ville && (
            <div class="hud-card__row">
              <dt>Ville</dt>
              <dd>{ville}</dd>
            </div>
          )}
          {programme && (
            <div class="hud-card__row">
              <dt>Programme</dt>
              <dd class="hud-card__desc">{programme}</dd>
            </div>
          )}
        </dl>
      )
    }
    {
      hasActions && (
        <div class="hud-card__actions">
          <slot name="actions" />
        </div>
      )
    }
  </div>
</div>

<style>
  /* Charte V3 cartouche: bleu clair ground, aubergine labels and hairlines. The project name stays
     corail as a display title; the values are running text and take --panel-ink, which corail
     cannot carry on a light panel (see tokens.css). */
  /* Outer frame = the same open-corner cartouche as the nav buttons, chips and footer cells
     (.brand-box, global.css). background-color overrides the utility's paper default; the four edge
     gradients it paints are what leave the corners open. */
  .hud-card {
    pointer-events: auto;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    max-width: min(92vw, 34rem);
    background-color: var(--panel-bg);
    --brand-box-line: var(--panel-line);
  }
  /* Internal dividers are drawn as inset pseudo-elements, not borders: the charte opens every
     junction as well as every corner, so each one stops --brand-box-gap short of the frame. */
  .hud-card__title,
  .hud-card__row + .hud-card__row,
  .hud-card__col > .hud-card__actions,
  .hud-card__actions > :global(* + *) {
    position: relative;
  }
  .hud-card__title::after,
  .hud-card__row + .hud-card__row::before,
  .hud-card__col > .hud-card__actions::before,
  .hud-card__actions > :global(* + *)::before {
    content: '';
    position: absolute;
    background: var(--panel-line);
  }
  /* Vertical: title | data column. */
  .hud-card__title::after {
    top: var(--brand-box-gap);
    bottom: var(--brand-box-gap);
    right: 0;
    width: var(--brand-box-w);
  }
  /* Horizontal: between data rows, above the actions row, and — while the action cells are stacked
     on mobile — between them too. */
  .hud-card__row + .hud-card__row::before,
  .hud-card__col > .hud-card__actions::before,
  .hud-card__actions > :global(* + *)::before {
    top: 0;
    left: var(--brand-box-gap);
    right: var(--brand-box-gap);
    height: var(--brand-box-w);
  }
  .hud-card__title {
    align-self: stretch;
    display: flex;
    align-items: center;
    margin: 0;
    padding: var(--space-3) var(--space-4);
    color: var(--color-coral);
    /* 700 is the non-colour cue that carries the title when corail alone cannot. */
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 1.25rem;
  }
  /* Column 2 stacks the data rows and, below them, the disclosure row — the V3 board's third row. */
  .hud-card__col {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .hud-card__data {
    margin: 0;
    display: grid;
  }
  /* Mobile: stack them, or « projets en relation » has ~7rem of column and truncates. They sit side
     by side from tablet up, split by the same hairline as the rows above. */
  .hud-card__actions {
    display: flex;
    flex-direction: column;
  }
  .hud-card__actions > :global(*) {
    min-width: 0;
  }
  @media (min-width: 48rem) {
    .hud-card__actions {
      flex-direction: row;
    }
    .hud-card__actions > :global(*) {
      flex: 1 1 0;
    }
    .hud-card__actions > :global(* + *)::before {
      top: var(--brand-box-gap);
      bottom: var(--brand-box-gap);
      left: 0;
      right: auto;
      width: var(--brand-box-w);
      height: auto;
    }
  }
  /* Narrower label column than before so the value keeps enough room to wrap on word boundaries on
     mobile (avoids mid-word clamps like "Restru… / de…"). min-content floor lets the widest label
     ("Programme" in the wide didone italic) size itself so it never clips, capped at 5.5rem. */
  .hud-card__row {
    display: grid;
    grid-template-columns: minmax(min-content, 5.5rem) minmax(0, 1fr);
    gap: var(--space-3);
    align-items: baseline;
    padding: var(--space-2) var(--space-4);
  }

  .hud-card__row dt {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--panel-ink);
  }
  .hud-card__row dd {
    margin: 0;
    color: var(--panel-ink);
    font-size: 0.9375rem;
  }
  /* The programme description can be long — cap it to two lines on the compact card. French compound
     words ("Restructuration") outrun the narrow value column on a 390px screen, and `overflow:hidden`
     would clip one mid-glyph instead of wrapping it, so hyphenate (html lang="fr") and allow a break. */
  .hud-card__desc {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    hyphens: auto;
    overflow-wrap: break-word;
  }
</style>
