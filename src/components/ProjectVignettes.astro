---
import ProjectCard from './ProjectCard.astro';
import { projectSearchText } from '../lib/search';
import type { ProjectSummary } from '../types/storyblok';

interface Props {
  projects: ProjectSummary[];
}

const { projects } = Astro.props;
---

{
  /* Vignettes view: a row-major grid of 4:5 portrait plan-masse tiles (2 cols mobile, 4 tablet,
    6 desktop — the page's 6-column grid, each tile under a filter column). Filtering hides
    non-matching <li>s; the rest regroup left. */
}
<div class="vignettes" data-view="grid">
  <ul class="vignettes__rail">
    {
      projects.map((project) => (
        <li
          class="vignettes__item"
          data-filterable
          data-programmes={project.programmes.map((p) => p.slug).join(' ')}
          data-thematiques={project.thematiques.join(' ')}
          data-search={projectSearchText(project)}
        >
          <ProjectCard project={project} variant="vignette" />
        </li>
      ))
    }
  </ul>
</div>

<style>
  .vignettes {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-height: 0;
  }
  .vignettes[hidden] {
    display: none;
  }

  .vignettes__rail {
    list-style: none;
    margin: 0;
    padding: 0 0 var(--space-2);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4) var(--space-3);
  }
  @media (min-width: 48rem) {
    .vignettes__rail {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  /* Same tracks and gutter as the brand column + the five filter columns above. */
  @media (min-width: 64rem) {
    .vignettes__rail {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      column-gap: var(--grid-gap);
    }
  }
  .vignettes__item {
    min-width: 0;
  }
  .vignettes__item[hidden] {
    display: none;
  }
</style>
