---
/**
 * Instagram mark — the client's corail disc (SVG/Insta corail.svg): the disc paints with
 * `currentColor`, the glyph is filled white so it stays legible over photos. The export's four white
 * corner fillers are dropped so the disc sits on a transparent square. Rendered inline (not <img>)
 * so currentColor resolves against the surrounding link colour.
 */
interface Props {
  size?: number | string;
  class?: string;
}
const { size = 24, class: className } = Astro.props;
---

