---
/**
 * LinkedIn mark — the client's corail disc (SVG/LK corail.svg): the disc paints with
 * `currentColor`, the "in" glyph is filled white so it stays legible over photos. The export's white
 * corner fillers are dropped so the disc sits on a transparent square. Rendered inline (not <img>)
 * so currentColor resolves against the surrounding link colour.
 */
interface Props {
  size?: number | string;
  class?: string;
}
const { size = 24, class: className } = Astro.props;
---

<svg
  class:list={['icon', className]}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 92.63 92.63"
  width={size}
  height={size}
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
>
