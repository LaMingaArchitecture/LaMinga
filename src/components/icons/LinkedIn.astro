  ></path>
  <path
    class="icon__glyph"
    d="M55.39,42.87c-2.16-.15-4.04.81-5.16,2.59-.59.94-.92,1.88-.94,3.04v17.89s-10.27,0-10.27,0l.04-11.42-.03-19.5h10.26s0,4.3,0,4.3l1.32-1.71c1.4-1.52,3.13-2.59,5.18-3.03,2.17-.46,4.39-.38,6.52.23,1.94.56,3.6,1.61,4.91,3.13,2.24,2.59,3.04,6.13,3.15,9.55v18.44s-10.26,0-10.26,0v-17.15c-.15-3.17-1.25-6.12-4.73-6.37Z"
