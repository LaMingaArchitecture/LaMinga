---
export const prerender = false;

import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';
import { STORYBLOK_VERSION } from 'astro:env/server';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { chromeFor } from '../../lib/layout';
import { getPreviewStory } from '../../lib/content';

// On-demand SSR route that renders DRAFT content live for the Storyblok Visual
// Editor. The guard keeps production effectively static: in the published
// environment this route returns 404 instead of serving drafts. The Visual
// Editor's preview URL points at /preview/ on the preview (SSR) deploy.
if (STORYBLOK_VERSION !== 'draft') {
  return new Response('Not found', { status: 404 });
}

const slug = Astro.params.slug ?? 'home';

// Only a missing story (404) reads as "introuvable"; auth/network/5xx errors propagate as a 500
// so a revoked Preview token is not mistaken for a missing story.
const content = await getPreviewStory(slug);

if (!content) {
  return new Response(`Aperçu introuvable : ${slug}`, { status: 404 });
}

// Mirror each page's production chrome so the Visual Editor preview matches the live page — same
// source as the production routes (src/lib/layout.ts), so the two cannot drift.
const chrome = chromeFor(content.component);
---

<BaseLayout title="Aperçu — LaMinga" {...chrome}>
  <StoryblokComponent blok={content} />
</BaseLayout>
