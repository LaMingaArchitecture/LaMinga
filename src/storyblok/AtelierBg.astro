---
/**
 * AtelierBg — the full-bleed background layer for one Atelier section: the §1 intro video (via
 * ResponsiveMedia) or a responsive photo (§2–4). Presentational (imported, not a registered blok).
 * Overscanned so the parallax drift (atelier-scroll.ts) never exposes an edge; `data-atelier-bg`
 * is the parallax hook (the script also toggles `will-change` on it only when parallax is active).
 */
import ResponsiveMedia from './ResponsiveMedia.astro';
import { sbImageW, sbSrcset, SIZES_FULLSCREEN, HERO_IMG_WIDTH } from '../lib/image';
import type { StoryblokAsset } from '../types/storyblok';

interface Props {
  image?: StoryblokAsset;
  video?: StoryblokAsset;
  poster?: StoryblokAsset;
  /** The first section's background is the page LCP → load eagerly + high priority. */
  eager?: boolean;
}
const { image, video, poster, eager = false } = Astro.props;

// Responsive full-bleed sources on the shared width ladder (sizes=100vw), so the atelier photo and
// its preload link (src/lib/media.ts / BaseLayout) resolve to identical URLs — no double-download.
const src = image?.filename ? sbImageW(image.filename, HERO_IMG_WIDTH) : undefined;
const srcset = image?.filename ? sbSrcset(image.filename) : undefined;

// Transparent 1×1: a valid `src` for the deferred backgrounds, so nothing is fetched until
// atelier-scroll hands over the real source. Allowed by the CSP (`img-src 'self' data:`).
const BLANK = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';

// Shared by the eager / deferred / no-JS branches so the three cannot drift apart. `alt` stays an
// explicit attribute on each tag — inside a spread, eslint-plugin-jsx-a11y cannot see it.
const alt = image?.alt ?? '';
const imgAttrs = { sizes: SIZES_FULLSCREEN, decoding: 'async' as const };
---

<div class="atelier__bg" data-atelier-bg>
  {
    video?.filename ? (
      <ResponsiveMedia video={video} poster={poster} alt="" loading="eager" />
    ) : (
      src &&
      (eager ? (
        <img
          src={src}
          srcset={srcset}
          alt={alt}
          loading="eager"
          fetchpriority="high"
          {...imgAttrs}
        />
      ) : (
        <Fragment>
          {/* Deferred until after the LCP — see the note on setupLazyBg in atelier-scroll.ts. The
              section clips its overscan (`.atelier__sec { overflow: hidden }`), so none of this
              image is on screen while the hero paints, even though its box crosses the fold.
              No `loading`: the src is a data: URI, so there is nothing for it to defer. */}
          <img data-src={src} data-srcset={srcset} src={BLANK} alt={alt} {...imgAttrs} />
          {/* No-JS path. Relies on the layer's children being absolutely positioned: this paints
              over the placeholder instead of being laid out below it, where the section would
              clip it away entirely. */}
          <noscript>
            <img src={src} srcset={srcset} alt={alt} loading="lazy" {...imgAttrs} />
          </noscript>
        </Fragment>
      ))
    )
  }
</div>

<style>
  .atelier__bg {
    position: absolute;
    inset-inline: 0;
    /* Overscan: keep in sync with the parallax FACTOR in atelier-scroll.ts (drift stays < 15%). */
    top: -15%;
    height: 130%;
    z-index: 0;
  }
  /* :global — the §1 <video> comes from the child ResponsiveMedia component (no scope attr here);
     the §2–4 <img> is in-template but covered too.
     Absolute, not in flow: a deferred section ships two images (the placeholder and the <noscript>
     copy) and they have to stack. In flow the second one lays out a full layer-height below the
     first and the section clips it away, so the no-JS page would have no background at all. */
  .atelier__bg :global(img),
  .atelier__bg :global(video),
  .atelier__bg :global(picture) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* If reduced motion is toggled on mid-session, drop any parallax transform the script wrote. */
  @media (prefers-reduced-motion: reduce) {
    .atelier__bg {
      transform: none !important;
    }
  }
</style>
