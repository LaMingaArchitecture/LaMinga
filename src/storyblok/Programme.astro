---
import { storyblokEditable } from '@storyblok/astro';
import type { ProgrammeBlok } from '../types/storyblok';

// Programme is a relation target; this standalone render is a minimal chip for the Visual Editor.
const { blok } = Astro.props as { blok: ProgrammeBlok };
---

<span class="programme" {...storyblokEditable(blok)}>
  {blok.nom}
</span>

<style>
  .programme {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    border: var(--border-w) solid var(--accent);
    border-radius: var(--radius);
    color: var(--accent);
    font-size: 0.875rem;
  }
</style>
