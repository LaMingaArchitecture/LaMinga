---
import { storyblokEditable } from '@storyblok/astro';
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';
import FullscreenCarousel from '../components/FullscreenCarousel.astro';
import ProjectHudCard from '../components/ProjectHudCard.astro';
import ProjectInfoOverlay from '../components/ProjectInfoOverlay.astro';
import ProjectRelatedBand from '../components/ProjectRelatedBand.astro';
import ProjectRecapSlide from '../components/ProjectRecapSlide.astro';
import { resolveRelated } from '../lib/content';
import type { ProjectBlok } from '../types/storyblok';

const { blok } = Astro.props as { blok: ProjectBlok };
const related = resolveRelated(blok);
const slides = blok.carrousel ?? [];
// The recap mosaic is only worth a slide when there are ≥2 visuals; it counts in the "X / N".
const showRecap = slides.length >= 2;
const slideCount = slides.length + (showRecap ? 1 : 0);
const hasRelated = related.length > 0;

// Data-sheet rows (info overlay), empty fields dropped so no blank rows render.
const data: Array<[string, string | undefined]> = [
  ["Maîtrise d'ouvrage", blok.maitre_ouvrage],
  ['Équipe', blok.equipe],
  ['Statut', blok.statut],
  ['m² SDP', blok.surface_sdp],
  ['Montant HT', blok.montant_ht],
  ['Divers', blok.divers],
];
const rows = data.filter(([, value]) => Boolean(value));
// The "+ infos" overlay only adds value beyond the card when there are extra facts to show.
const infosHasContent =
  rows.length > 0 || Boolean(blok.texte) || (blok.engagements?.length ?? 0) > 0;
---

<FullscreenCarousel
  controls="grouped"
  counter
  ariaLabel={blok.titre}
  slideCount={slideCount}
  {...storyblokEditable(blok)}
>
  {slides.map((slide, i) => <StoryblokComponent blok={slide} first={i === 0} />)}
  {showRecap && <ProjectRecapSlide slides={slides} />}

  <div class="project-hud" data-project-overlays slot="overlays">
    {infosHasContent && <ProjectInfoOverlay id="project-infos" blok={blok} rows={rows} />}
    {hasRelated && <ProjectRelatedBand id="project-similaires" related={related} />}

    <div class="project-hud__bar">
      <div class="project-hud__card">
        <ProjectHudCard
          titre={blok.titre}
          ville={blok.ville}
          programme={blok.description_programme}
        >
          <Fragment slot="actions">
            {
              infosHasContent && (
                <button
                  type="button"
                  class="pill pill--infos"
                  aria-expanded="false"
                  aria-controls="project-infos"
                  data-overlay-pill="infos"
                >
                  <span class="pill__badge" aria-hidden="true" />
                  <span class="pill__label">informations</span>
                </button>
              )
            }
            {
              hasRelated && (
                <button
                  type="button"
                  class="pill pill--similaires"
                  aria-expanded="false"
                  aria-controls="project-similaires"
                  data-overlay-pill="similaires"
                >
                  <span class="pill__badge" aria-hidden="true" />
                  <span class="pill__label">projets en relation</span>
                </button>
              )
            }
          </Fragment>
        </ProjectHudCard>
      </div>
    </div>
  </div>
</FullscreenCarousel>

<script>
  import '../scripts/project-overlays';
</script>

<style>
  /* HUD layer over the carousel: full-bleed, click-through except on its interactive children.
     --band-* bound the info/related overlays so they clear the floating header and the bottom bar. */
  .project-hud {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    /* Bounds for the info/related overlays. The card is hidden while an overlay is open, so the
       bottom only needs to clear the active pill + counter row. */
    --band-top: calc(var(--nav-clear) + var(--space-3));
    --band-bottom: 5.5rem;
    --band-x: var(--space-4);
  }

  /* Bottom bar: holds the cartouche, which now carries the disclosure buttons as its last row.
     z-index keeps them clickable above an open overlay; the carousel counter sits above all of it. */
  .project-hud__bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4);
    /* Clear the carousel's ‹ X/N › cluster, which sits in this same bottom-right corner. */
    padding-bottom: calc(2.75rem + max(var(--space-4), env(safe-area-inset-bottom)));
    pointer-events: none;
  }
  .project-hud__bar > * {
    pointer-events: auto;
  }

  .project-hud__card {
    align-self: center;
    max-width: 100%;
  }
  .project-hud[data-overlay-open] .project-hud__card {
    align-self: start;
  }

  /* A cartouche cell, not a floating pill: the cell's own hairlines come from .hud-card__actions. */
  .pill {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    width: 100%;
    min-height: 44px;
    padding: var(--space-2) var(--space-3);
    border: 0;
    background: none;
    color: var(--panel-ink);
    font: inherit;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.9375rem;
    text-align: left;
    cursor: pointer;
    touch-action: manipulation;
  }
  /* The +/− sign is drawn as two centered bars (pixel-perfect, unlike a text glyph); the vertical
     bar collapses when the pill is expanded, so "+" becomes "−" purely from aria-expanded. */
  .pill__badge {
    position: relative;
    flex-shrink: 0;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
  }
  .pill__badge::before,
  .pill__badge::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: var(--color-paper);
    border-radius: 1px;
    transition: transform var(--transition);
  }
  .pill__badge::before {
    width: 0.8125rem;
    height: 2px;
  }
  .pill__badge::after {
    width: 2px;
    height: 0.8125rem;
  }
  .pill[aria-expanded='true'] .pill__badge::after {
    transform: translate(-50%, -50%) scaleY(0);
  }
  .pill__badge {
    background: var(--color-coral);
  }

  /* While an overlay is open the cartouche disappears and only the active button survives, stripped
     back to a bare "−" disc (V3 board). The card keeps its box in the layout but loses its chrome
     and its text: the <h1> is the page's only heading, so it is clipped sr-only rather than
     display:none and stays in the a11y tree. The inactive button is removed outright. */
  .project-hud[data-overlay-open] :global(.hud-card) {
    background: none;
    border-color: transparent;
  }
  .project-hud[data-overlay-open] :global(.hud-card__title),
  .project-hud[data-overlay-open] :global(.hud-card__data) {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
  .project-hud[data-overlay-open] :global(.hud-card__actions),
  .project-hud[data-overlay-open] :global(.hud-card__actions > *) {
    border: 0;
  }
  .project-hud[data-overlay-open] .pill[aria-expanded='false'] {
    display: none;
  }
  /* Clipped, not display:none — the label is the button's accessible name, and the button survives
     the open state as the close affordance. `aria-expanded` conveys that activating it collapses. */
  .project-hud[data-overlay-open] .pill__label {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .project-hud[data-overlay-open] .pill {
    /* Label gone, so the button shrinks to its disc — keep a 44px hit area around it, aligned left
       so the disc itself stays where the board puts it. */
    width: auto;
    min-width: 2.75rem;
    justify-content: flex-start;
    padding: 0;
    filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.35));
  }

  @media (min-width: 48rem) {
    .project-hud {
      /* The brand block is the logotype (--nav-clear lands on its bottom edge) plus the two stacked
         cartouches hanging below it, so the bands have to clear roughly 6rem more than the logotype
         alone — otherwise the info/related panels tuck under the floating nav in column 1. */
      --band-top: var(--nav-brand-h);
      --band-bottom: 5.5rem;
      --band-x: var(--space-6);
    }
    /* Cartouche centred, with the outer columns reserving the bottom-right counter's corner. */
    .project-hud__bar {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: end;
      gap: var(--space-4);
      padding: var(--space-6);
    }
    .project-hud__card {
      grid-column: 2;
      justify-self: center;
    }
    /* Open: the lone "−" returns to the bottom-left corner the board puts it in. */
    .project-hud[data-overlay-open] .project-hud__card {
      grid-column: 1;
      justify-self: start;
    }
  }
</style>
