---
import { storyblokEditable } from '@storyblok/astro';
import RichText from './RichText.astro';
import { sbImage } from '../lib/image';
import type { TeamMemberBlok } from '../types/storyblok';

const { blok } = Astro.props as { blok: TeamMemberBlok };
---

<figure class="team-member" {...storyblokEditable(blok)}>
  {
    blok.photo?.filename && (
      <div class="team-member__frame brand-box">
        <img
          class="team-member__photo"
          src={sbImage(blok.photo.filename, '500x500')}
          alt={blok.photo.alt ?? blok.nom}
          width="500"
          height="500"
          loading="lazy"
        />
      </div>
    )
  }
  <figcaption class="team-member__caption">
    <span class="team-member__name">{blok.nom}</span>
    {blok.role && <span class="team-member__role">{blok.role}</span>}
    {blok.bio && <RichText doc={blok.bio} />}
  </figcaption>
</figure>

<style>
  .team-member {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  /* The board frames each portrait in the corail cartouche — an open-corner rule standing clear of
     the photo, not a border hugging it. The panel colour shows through, so the .brand-box paper
     ground is cleared rather than inherited. */
  .team-member__frame {
    --brand-box-line: var(--color-coral);
    background-color: transparent;
    padding: var(--space-3);
  }
  /* Black-and-white via CSS so colour uploads still render greyscale. */
  .team-member__photo {
    display: block;
    width: 100%;
    /* height:auto lets aspect-ratio drive the square; without it the width/height attrs (CLS hints)
       set an explicit height that combines with width:100% and distorts the crop. */
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    filter: grayscale(100%);
  }
  .team-member__caption {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  /* The board draws name and role corail; not adopted — at this size they are running text, which
     corail cannot carry on a light panel (see tokens.css). */
  .team-member__name {
    color: var(--panel-ink);
    font-weight: 700;
    line-height: 1.2;
  }
  .team-member__role {
    color: var(--panel-ink);
    font-family: var(--font-serif);
    font-style: italic;
  }
  .team-member :global(.richtext) {
    margin-top: var(--space-2);
    color: var(--panel-ink);
    font-size: 0.85rem;
    line-height: 1.45;
  }
</style>
